CF_ACCOUNT_ID=
CF_API_TOKEN=
CF_D1_DATABASE_ID=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_SECRET_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# AI providers (configure at least one, or set AI_PROVIDER=manual)
AI_PROVIDER=manual
AI_PROVIDER_ORDER=gemini,groq,workers_ai
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Blogger (Google OAuth — consent screen MUST be "In production")
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
BLOGGER_CLIENT_ID=
BLOGGER_CLIENT_SECRET=
BLOGGER_REFRESH_TOKEN=
BLOGGER_BLOG_ID=

# LinkedIn
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_MEMBER_URN=

# DEV.to
DEVTO_API_KEY=

# Hashnode (disabled by default — requires paid Pro)
HASHNODE_PAT=
HASHNODE_PUBLICATION_ID=

# X (disabled by default — pay-per-use)
X_ACCESS_TOKEN=

# GitHub (Worker triggers publish workflow)
GH_DISPATCH_PAT=
GH_REPO_OWNER=
GH_REPO_NAME=
GH_DISPATCH_REF=main

# Runtime
DRY_RUN=true
NODE_ENV=development
